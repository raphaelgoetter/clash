{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install && cd frontend && npm install",
  "framework": null,
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)jeux' ':(exclude).github' ':(exclude)temp' ':(exclude)outils' ':(exclude)scripts' ':(exclude)*.md'",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/discord/interactions.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/api/bac/:path*", "destination": "https://kevina-jeux.vercel.app/api/bac/:path*", "permanent": true },
    { "source": "/api/blackjack/:path*", "destination": "https://kevina-jeux.vercel.app/api/blackjack/:path*", "permanent": true },
    { "source": "/api/coffre/:path*", "destination": "https://kevina-jeux.vercel.app/api/coffre/:path*", "permanent": true },
    { "source": "/api/frames/:path*", "destination": "https://kevina-jeux.vercel.app/api/frames/:path*", "permanent": true },
    { "source": "/api/frise/:path*", "destination": "https://kevina-jeux.vercel.app/api/frise/:path*", "permanent": true },
    { "source": "/api/goblinhunters/:path*", "destination": "https://kevina-jeux.vercel.app/api/goblinhunters/:path*", "permanent": true },
    { "source": "/api/intrus/:path*", "destination": "https://kevina-jeux.vercel.app/api/intrus/:path*", "permanent": true },
    { "source": "/api/marioclash/:path*", "destination": "https://kevina-jeux.vercel.app/api/marioclash/:path*", "permanent": true },
    { "source": "/api/mascarade/:path*", "destination": "https://kevina-jeux.vercel.app/api/mascarade/:path*", "permanent": true },
    { "source": "/api/meow/:path*", "destination": "https://kevina-jeux.vercel.app/api/meow/:path*", "permanent": true },
    { "source": "/api/pelemele/:path*", "destination": "https://kevina-jeux.vercel.app/api/pelemele/:path*", "permanent": true },
    { "source": "/api/pendu/:path*", "destination": "https://kevina-jeux.vercel.app/api/pendu/:path*", "permanent": true },
    { "source": "/api/platpays/:path*", "destination": "https://kevina-jeux.vercel.app/api/platpays/:path*", "permanent": true },
    { "source": "/api/pont/:path*", "destination": "https://kevina-jeux.vercel.app/api/pont/:path*", "permanent": true },
    { "source": "/api/potato/:path*", "destination": "https://kevina-jeux.vercel.app/api/potato/:path*", "permanent": true },
    { "source": "/api/quatre/:path*", "destination": "https://kevina-jeux.vercel.app/api/quatre/:path*", "permanent": true },
    { "source": "/api/quiestce/:path*", "destination": "https://kevina-jeux.vercel.app/api/quiestce/:path*", "permanent": true },
    { "source": "/api/robinson/:path*", "destination": "https://kevina-jeux.vercel.app/api/robinson/:path*", "permanent": true },
    { "source": "/api/sekoidon/:path*", "destination": "https://kevina-jeux.vercel.app/api/sekoidon/:path*", "permanent": true },
    { "source": "/api/zoom/:path*", "destination": "https://kevina-jeux.vercel.app/api/zoom/:path*", "permanent": true },
    { "source": "/api/zoom2/:path*", "destination": "https://kevina-jeux.vercel.app/api/zoom2/:path*", "permanent": true },
    { "source": "/images/blackjack/:path*", "destination": "https://kevina-jeux.vercel.app/images/blackjack/:path*", "permanent": true },
    { "source": "/images/concept/:path*", "destination": "https://kevina-jeux.vercel.app/images/concept/:path*", "permanent": true },
    { "source": "/images/gobelet/:path*", "destination": "https://kevina-jeux.vercel.app/images/gobelet/:path*", "permanent": true },
    { "source": "/images/robinson/:path*", "destination": "https://kevina-jeux.vercel.app/images/robinson/:path*", "permanent": true },
    { "source": "/images/synopsis/:path*", "destination": "https://kevina-jeux.vercel.app/images/synopsis/:path*", "permanent": true },
    { "source": "/images/trivia/:path*", "destination": "https://kevina-jeux.vercel.app/images/trivia/:path*", "permanent": true },
    { "source": "/images/triviageek/:path*", "destination": "https://kevina-jeux.vercel.app/images/triviageek/:path*", "permanent": true },
    { "source": "/fr/player/:tag", "destination": "/player/:tag", "permanent": true },
    { "source": "/en/player/:tag", "destination": "/player/:tag", "permanent": true },
    { "source": "/fr/clan/:tag", "destination": "/clan/:tag", "permanent": true },
    { "source": "/en/clan/:tag", "destination": "/clan/:tag", "permanent": true },
    { "source": "/fr/bot", "destination": "/bot/", "permanent": true },
    { "source": "/fr/bot/", "destination": "/bot/", "permanent": true },
    {
      "source": "/fr/deck-upgrade",
      "destination": "/deck-upgrade/",
      "permanent": true
    },
    {
      "source": "/fr/deck-upgrade/",
      "destination": "/deck-upgrade/",
      "permanent": true
    },
    {
      "source": "/en/deck-upgrade",
      "destination": "/deck-upgrade/",
      "permanent": true
    },
    {
      "source": "/en/deck-upgrade/",
      "destination": "/deck-upgrade/",
      "permanent": true
    },
    { "source": "/fr/", "destination": "/", "permanent": true },
    { "source": "/fr", "destination": "/", "permanent": true },
    { "source": "/en/", "destination": "/", "permanent": true },
    { "source": "/en", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/deck-upgrade", "destination": "/deck-upgrade/index.html" },
    { "source": "/deck-upgrade/", "destination": "/deck-upgrade/index.html" },
    { "source": "/bot", "destination": "/bot/index.html" },
    { "source": "/bot/", "destination": "/bot/index.html" },
    { "source": "/matchup", "destination": "/matchup/index.html" },
    { "source": "/matchup/", "destination": "/matchup/index.html" },
    { "source": "/player/:tag", "destination": "/api/index.js" },
    { "source": "/clan/:tag", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
